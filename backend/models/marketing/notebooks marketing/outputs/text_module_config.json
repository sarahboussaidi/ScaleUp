{
  "version": "6.2",
  "module": "text_evaluation",
  "key_fix": "Separate text-only vs fusion R\u00b2 + data-driven startup target matching + user target profiles",
  "sentiment_model": "cardiffnlp/twitter-roberta-base-sentiment-latest",
  "platforms_supported": [
    "instagram",
    "linkedin",
    "twitter",
    "facebook"
  ],
  "profile_modes_supported": [
    "data",
    "user",
    "hybrid"
  ],
  "user_target_profiles_supported": true,
  "target_profile_schema": {
    "platform": "instagram|linkedin|twitter|facebook",
    "audience": "free-text target audience description",
    "goal": "engagement|lead generation|awareness|conversion",
    "tone": "positive|neutral|negative",
    "target_len_min": "int",
    "target_len_max": "int",
    "target_hashtag_min": "int",
    "target_hashtag_max": "int",
    "keywords": "list[str] or comma-separated string"
  },
  "xgb_trained": true,
  "dimensions": {
    "sentiment": "Twitter RoBERTa with bounded linear mapping",
    "structure": "Rule-based: length, CTA, caps, emojis, questions",
    "hashtags": "Rule-based: platform-specific optimal count ranges",
    "target_match": "Data-driven profile fit from imported startup engagement data"
  },
  "dimension_weights": {
    "instagram": {
      "sentiment": 0.3125,
      "structure": 0.3125,
      "hashtags": 0.375
    },
    "linkedin": {
      "sentiment": 0.2857,
      "structure": 0.5,
      "hashtags": 0.2143
    },
    "twitter": {
      "sentiment": 0.4286,
      "structure": 0.4286,
      "hashtags": 0.1429
    },
    "facebook": {
      "sentiment": 0.4286,
      "structure": 0.5,
      "hashtags": 0.2143
    }
  },
  "platform_benchmarks": {
    "instagram": {
